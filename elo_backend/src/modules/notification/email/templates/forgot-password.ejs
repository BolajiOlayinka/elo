<%- include('sections/header') %>

<!-- Forgot Password section -->
<table width="100%" border="0" cellspacing="0" cellpadding="0">
    <tr>
        <td>
            <h2 style="color: #333333; margin: 0 0 20px 0; font-size: 18px; font-weight: 600;">Password Reset Request</h2>
            
            <p style="color: #666666; margin: 0 0 20px 0; font-size: 14px; line-height: 1.5;">
                We received a request to reset the password for your account associated with this email address.
            </p>
            
            <div>
                <h3 style="color: #333333; margin: 0 0 15px 0; font-size: 16px; font-weight: 600;">Your Reset Token</h3>
                <p style="color: #666666; margin: 0 0 10px 0; font-size: 14px; line-height: 1.6;">
                    <strong>Reset Token:</strong> <span style="background-color: #e9ecef; padding: 5px 10px; border-radius: 4px; font-family: monospace;"><%= RESET_TOKEN %></span>
                </p>
                <p style="color: #666666; margin: 0; font-size: 12px; line-height: 1.4;">
                    <strong>Important:</strong> This token will expire in 1 hour and can only be used once. 
                    Please use this token to reset your password through our application.
                </p>
                <p style="color: #666666; margin: 0; font-size: 12px; line-height: 1.4;">Never share this token with anyone</p>
                <p style="color: #666666; margin: 0; font-size: 12px; line-height: 1.4;">If you didn't request this reset, please ignore this email</p>
                <p style="color: #666666; margin: 0; font-size: 12px; line-height: 1.4;">Your password will remain unchanged if this token expires</p>
            </div>
            
            <p style="color: #666666; margin: 20px 0 0 0; font-size: 14px; line-height: 1.5;">
                If you continue to have problems, please contact our support team.
            </p>
        </td>
    </tr>
</table>

<%- include('sections/footer') %>
