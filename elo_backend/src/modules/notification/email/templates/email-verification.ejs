<%- include('sections/header') %>

<!-- Verification code section -->
<table width="100%" border="0" cellspacing="0" cellpadding="0">
    <tr>
        <td style="text-align: center;">
            <h2 style="color: #333333; margin: 0 0 0px 0; font-size: 16px; font-weight: 600;">Verification code</h2>
            
            <!-- Code display -->
            <div style="background-color: #f8f9fa; border: 2px solid #e9ecef; border-radius: 8px; padding: 10px; margin: 10px 0; display: inline-block;">
                <span style="font-size: 30px; font-weight: bold; color: #333333; letter-spacing: 4px;"><%=VERIFICATION_CODE %></span>
            </div>
            
            <!-- Expiration notice -->
            <p style="color: #666666; margin: 0px 0 0 0; font-size: 12px;">This code expires in 15 minutes after it was sent</p>
        </td>
    </tr>
</table>

<%- include('sections/footer') %>
